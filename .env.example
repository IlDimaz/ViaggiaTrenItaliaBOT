# Copy this file to ".env" and fill in your token.
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# Optional tuning
DEPARTURES_WINDOW_MINUTES=90
ALERTS_POLL_SECONDS=300
TRACK_SECONDS=300
SCHEDULE_LEAD_MINUTES=30

# Override the HTTP User-Agent if needed (Akamai blocks non-browser clients).
# USER_AGENT=Mozilla/5.0 ...

# Telegram user id(s) allowed to run /stats (comma-separated). Empty disables it.
# ADMIN_USER_IDS=123456789
